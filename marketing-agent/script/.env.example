# Example environment for running the marketing draft agent locally.
# Copy to a private, untracked location and fill in real values, e.g.:
#   set -a; source ./.env; set +a; node run.js
# NEVER commit real secret values. In production these come from GitHub Actions
# repo secrets/variables (see ../../.github/workflows/marketing-agent.yml), NOT
# from this file.

# --- Secrets (required) ---
GEMINI_API_KEY=your-google-ai-studio-api-key
RESEND_API_KEY=your-resend-api-key
# Dedicated read-only Firestore service-account key: raw JSON on one line, or
# its base64 encoding. Optional locally — omit to use your gcloud ADC instead
# (GOOGLE_APPLICATION_CREDENTIALS / `gcloud auth application-default login`).
# FIREBASE_SA_KEY={"type":"service_account","project_id":"nohungrypets",...}

# --- Non-secret config (optional — these are the in-code defaults) ---
# onboarding@resend.dev (Resend's shared sandbox address) needs no domain setup
# but can only deliver to the email you signed up to Resend with. See README.
FROM_EMAIL=onboarding@resend.dev
RECIPIENT_EMAIL=info.nohungrypets@gmail.com
SCHEDULE_START_DATE=2026-08-04
LAUNCH_COUNTDOWN_UNTIL=
SITE_URL=https://nohungrypets.co.uk
FACEBOOK_URL=https://www.facebook.com/nohungrypets
GEMINI_TEXT_MODEL=gemini-3.6-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
STATS_DOC_PATH=stats/global
FIRESTORE_DATABASE_ID=(default)
