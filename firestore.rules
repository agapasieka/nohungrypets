// Copyright (c) 2026 NoHungryPets
// Firestore Security Rules for NoHungryPets
// Synced 2026-08-01 to match what's actually deployed in the Firebase Console —
// the previous committed version had drifted (a dead-code claim-update clause
// in `listings`, and a stricter-than-reality `conversations`/`messages` block).

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /listings/{listingId} {
      allow read: if true;
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null
                    && (
                      request.auth.uid == resource.data.userId
                      || (request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly(['status', 'claimedAt'])
                          && request.resource.data.status == 'claimed')
                    );
    }

    // Global platform stats - denormalised vanity counters for the admin dashboard.
    // Only the site owner (hardcoded admin UID) may READ the aggregate doc,
    // but any signed-in user may increment the counters (non-sensitive metrics;
    // Firebase Analytics remains the authoritative, tamper-proof traffic source).
    // Writes are restricted to the known counter fields only, so a signed-in user
    // can't smuggle arbitrary data onto this doc via set(..., {merge:true}).
    match /stats/global {
      allow read: if request.auth != null
                  && request.auth.uid == 'YVK880UJPFOaqwB2uk1lddqF2fK2';

      allow create: if request.auth != null
                    && request.resource.data.keys()
                       .hasOnly(['totalUsers', 'totalListings', 'totalClaims']);

      // set(..., {merge:true}) with FieldValue.increment counts as an update
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['totalUsers', 'totalListings', 'totalClaims']);
    }

    match /conversations/{conversationId} {
      allow read, write: if request.auth != null
                         && (resource == null
                             || request.auth.uid in resource.data.participants);

      match /messages/{messageId} {
        allow read, write: if request.auth != null
                           && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
      }
    }
  }
}
