// Copyright (c) 2026 NoHungryPets
// Firestore Security Rules for NoHungryPets
// Synced 2026-08-01 to match what's actually deployed in the Firebase Console —
// the previous committed version had drifted (a dead-code claim-update clause
// in `listings`, and a stricter-than-reality `conversations`/`messages` block).

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // An account is an admin if a document exists at admins/{their-uid}.
    // Admin docs are created/removed only from the Firebase Console (no client
    // write rule below), so being an admin can't be self-granted from the app.
    function isAdmin() {
      return request.auth != null
             && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Each account may read its own admins/{uid} doc (so the admin page can
    // check "am I an admin?"). No create/update/delete from the client —
    // admins are managed in the Firebase Console.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
    }

    match /users/{userId} {
      // A user can read/write their own record; an admin can read any record
      // (for the admin dashboard — signup counts and the recent-signups list).
      allow read:  if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /listings/{listingId} {
      allow read: if true;
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null
                    && (
                      request.auth.uid == resource.data.userId
                      || (request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly(['status', 'claimedAt'])
                          && request.resource.data.status == 'claimed')
                    );
    }

    // Global platform stats - denormalised vanity counters.
    // Publicly READABLE: the homepage surfaces `totalListings` as a public
    // "X food items shared" milestone number for signed-out visitors, and the
    // doc holds only non-sensitive vanity counts (no user data). Any signed-in
    // user may increment the counters (Firebase Analytics remains the
    // authoritative, tamper-proof traffic source). Writes are restricted to the
    // known counter fields only, so a signed-in user can't smuggle arbitrary
    // data onto this doc via set(..., {merge:true}).
    match /stats/global {
      allow read: if true;

      allow create: if request.auth != null
                    && request.resource.data.keys()
                       .hasOnly(['totalUsers', 'totalListings', 'totalClaims']);

      // set(..., {merge:true}) with FieldValue.increment counts as an update
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['totalUsers', 'totalListings', 'totalClaims']);
    }

    match /conversations/{conversationId} {
      allow read, write: if request.auth != null
                         && (resource == null
                             || request.auth.uid in resource.data.participants);

      match /messages/{messageId} {
        allow read, write: if request.auth != null
                           && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
      }
    }
  }
}
